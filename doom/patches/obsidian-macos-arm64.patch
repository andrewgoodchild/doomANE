diff --git a/source_files/lua/src/CMakeLists.txt b/source_files/lua/src/CMakeLists.txt
index 5979fe1..8166e52 100644
--- a/source_files/lua/src/CMakeLists.txt
+++ b/source_files/lua/src/CMakeLists.txt
@@ -292,6 +292,18 @@ else()
   set(TARGET_OS_FLAGS ${TARGET_OS_FLAGS} -DLUAJIT_OS=LUAJIT_OS_OTHER)
 endif()
 
+# Fixed first mmap address for the LuaJIT allocator, so that map generation
+# is reproducible from a seed (table iteration order depends on addresses).
+set(LUAJIT_FIXED_MMAP_HINT
+    "0x200000000000"
+    CACHE STRING "Fixed start address for LuaJIT mmap probing (empty = ASLR)"
+)
+if(LJ_64 AND LUAJIT_FIXED_MMAP_HINT)
+  set(LJ_DEFINITIONS ${LJ_DEFINITIONS}
+                     -DLUAJIT_FIXED_MMAP_HINT=${LUAJIT_FIXED_MMAP_HINT}
+  )
+endif()
+
 if(LUAJIT_DISABLE_GC64)
   set(LJ_DEFINITIONS ${LJ_DEFINITIONS} -DLUAJIT_DISABLE_GC64)
   set(TARGET_ARCH ${TARGET_ARCH} -DLUAJIT_DISABLE_GC64)
