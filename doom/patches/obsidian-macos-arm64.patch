 static void *mmap_probe(PRNGState *rs, size_t size)
 {
   /* Hint for next allocation. Doesn't need to be thread-safe. */
+#ifdef LUAJIT_FIXED_MMAP_HINT
+  /* Start at a fixed address so that GC object addresses (and hence the
+  ** iteration order of tables keyed by objects) do not depend on ASLR.
+  ** Obsidian needs this for reproducible maps from a seed. */
+  static uintptr_t hint_addr = (uintptr_t)LUAJIT_FIXED_MMAP_HINT;
+#else
   static uintptr_t hint_addr = 0;
+#endif
   int olderr = errno;
   int retry;
   for (retry = 0; retry < LJ_ALLOC_MMAP_PROBE_MAX; retry++) {
