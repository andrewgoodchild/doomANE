diff --git a/tests/test_floor_switches.py b/tests/test_floor_switches.py
new file mode 100644
index 0000000..a7a5397
--- /dev/null
+++ b/tests/test_floor_switches.py
@@ -0,0 +1,23 @@
+import unittest
+from pathlib import Path
+import vizdoom
+from doomlib.mission import map_data
+
+WAD = Path(vizdoom.__file__).parent / 'freedoom2.wad'
+
+
+class FloorSwitchTest(unittest.TestCase):
+    def test_lower_to_highest_neighbour_switch_is_a_floor_switch(self):
+        # MAP04 line 883 (S1 lower floor to highest neighbour) opens the way to the red key.
+        switch = next(s for s in map_data(WAD, 'MAP04')['switches'] if s['id'] == 883)
+        self.assertEqual(switch['kind'], 'floor')
+        self.assertEqual(switch['initial_floors'], {54: 8})
+
+    def test_known_maps_keep_their_switches(self):
+        kinds = {m: [(s['id'], s['kind']) for s in map_data(WAD, m)['switches']] for m in ('MAP01', 'MAP03')}
+        self.assertEqual(kinds['MAP01'], [(839, 'door')])
+        self.assertEqual([s for s in kinds['MAP03'] if s[1] == 'floor'], [(2839, 'floor')])
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_rocket_safety.py b/tests/test_rocket_safety.py
new file mode 100644
index 0000000..f0d5983
--- /dev/null
+++ b/tests/test_rocket_safety.py
@@ -0,0 +1,32 @@
+import unittest
+
+from doomlib.combat import ROCKET_SAFE_METERS, fire_reaches, fire_tolerance
+from doomlib.executor import Executor
+
+
+class RocketSafetyTest(unittest.TestCase):
+    def test_rocket_launcher_does_not_reach_inside_its_blast_radius(self):
+        self.assertFalse(fire_reaches(5, ROCKET_SAFE_METERS - 0.5))
+        self.assertTrue(fire_reaches(5, ROCKET_SAFE_METERS + 0.5))
+
+    def test_melee_and_guns_keep_their_ranges(self):
+        self.assertTrue(fire_reaches(1, 1.4))
+        self.assertFalse(fire_reaches(9, 2.0))
+        self.assertTrue(fire_reaches(4, 1.0))
+
+    def test_close_enemies_are_fired_at_when_the_aim_is_inside_their_body(self):
+        self.assertGreater(fire_tolerance(1.6), 15)
+        self.assertEqual(fire_tolerance(10), 5.0)
+        for distance, fires in ((1.6, 1), (10, 0)):
+            e = Executor()
+            s = dict(x=0, y=0, angle=0, hp=100, weapon=3, ammo=10, walls=dict(left=10, right=10),
+                     enemies=[dict(id=1, bearing=8, aim_bearing=8, distance=distance, visible=True)],
+                     inventory={'3': {'owned': 1, 'ammo': 10}})
+            e.accept(dict(action='attack', target={'id': 1, 'name': 'Enemy'}, weapon=3, decision_id=1,
+                          command='attack', expires_tick=70), 0)
+            buttons, _ = e.act(s, 0)
+            self.assertEqual(buttons[5], fires)
+
+
+if __name__ == '__main__':
+    unittest.main()
