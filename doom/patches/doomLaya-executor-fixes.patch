 """Удержание видимой цели и выбор оружия из настоящего инвентаря."""
 import math
+import os
 
 WEAPON_NAMES = {1:'melee',2:'pistol',3:'shotgun',4:'chaingun',5:'rocket_launcher',6:'plasma_rifle',7:'BFG',8:'super_shotgun',9:'chainsaw'}
 
 WEAPON_SLOTS={**{i:i for i in range(1,8)},8:3,9:1}
 AMMO_COST={1:0,2:1,3:1,4:1,5:1,6:1,7:40,8:2,9:0}
+# A rocket's 128-unit blast also hurts the player: 20 of 186 MAP03 deaths followed a rocket choice, 16 within 6 m.
+ROCKET_SAFE_METERS=4.0
+
+
+# Fire while the aim is inside the target's body: most monsters are 20 units in radius. A fixed 5 degree
+# gate held fire in 37 % of close-range ticks with the selected enemy 5-20 degrees off centre.
+ENEMY_RADIUS_UNITS=20
+# DOOM_FIRE_LEGACY=1 restores the fixed 5 degree gate and unrestricted rockets, for A/B runs.
+FIRE_LEGACY=os.environ.get('DOOM_FIRE_LEGACY')=='1'
+
+
+def fire_tolerance(distance):
+    """Largest aim error in degrees that still hits an enemy at this distance in metres."""
+    if FIRE_LEGACY:return 5.0
+    return max(5.0,0.8*math.degrees(math.atan2(ENEMY_RADIUS_UNITS,max(distance,0.1)*32)))
+
+
+def fire_reaches(slot, distance):
+    """Whether the weapon in this slot can hit an enemy at this distance without hurting the player."""
+    if AMMO_COST[slot]==0:return distance<=1.5
+    if slot==5 and not FIRE_LEGACY:return distance>ROCKET_SAFE_METERS
+    return True
 
 
