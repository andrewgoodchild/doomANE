+import unittest
+
+from doomlib.policy import request
+
+
+class WeaponTextTest(unittest.TestCase):
+    def test_weapon_options_state_shots_left_not_raw_ammo(self):
+        inventory = {str(k): dict(owned=int(k in (1, 3, 4, 5, 9)), ammo={3: 50, 5: 2}.get(k, 0))
+                     for k in range(1, 10)}
+        state = dict(hp=50, armor=0, inventory=inventory, door=None, keys=[], walls=dict(left=3, right=3), execution={},
+                     enemies=[dict(id=1, name='DoomImp', distance=8.0, bearing=0, visible=True, x=0, y=0, z=0)])
+        criteria = request(state, {}, None)['questions']['weapon']['criteria']
+        self.assertTrue(criteria['shotgun'].endswith('Shots left: 50.'))
+        self.assertTrue(criteria['rocket_launcher'].endswith('Shots left: 2.'))
+        self.assertIn('Loaded: no', criteria['chaingun'])
+        self.assertTrue(criteria['chainsaw'].endswith('No ammunition needed.'))
+        self.assertNotIn('Ammo:', ' '.join(criteria.values()))
