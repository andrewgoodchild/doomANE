@@ -0,0 +1,40 @@
+import unittest
+from unittest import mock
+
+from doomlib import policy
+from doomlib.policy import request
+
+
+def criteria():
+    inventory = {str(k): dict(owned=int(k in (1, 3, 4, 5, 9)), ammo={3: 50, 5: 2}.get(k, 0))
+                 for k in range(1, 10)}
+    state = dict(hp=50, armor=0, inventory=inventory, door=None, keys=[], walls=dict(left=3, right=3), execution={},
+                 enemies=[dict(id=1, name='DoomImp', distance=8.0, bearing=0, visible=True, x=0, y=0, z=0)])
+    return request(state, {}, None)['questions']['weapon']['criteria']
+
+
+class WeaponTextTest(unittest.TestCase):
+    def test_weapon_options_keep_the_trained_raw_ammo_text(self):
+        # The weapon head was trained on 'Ammo: N'; other wordings make it pick empty guns.
+        with mock.patch.object(policy, 'WEAPON_TEXT_SHOTS', False):
+            c = criteria()
+        self.assertTrue(c['shotgun'].endswith('Ammo: 50.'))
+        self.assertTrue(c['rocket_launcher'].endswith('Ammo: 2.'))
+        self.assertIn('Loaded: no', c['chaingun'])
+        self.assertNotIn('Shots left', ' '.join(c.values()))
+
+    def test_melee_options_state_only_range_and_reach(self):
+        # 'Loaded: yes ... Ammo: 0' drew the head to the chainsaw once the chaingun was empty.
+        with mock.patch.object(policy, 'WEAPON_TEXT_SHOTS', False):
+            c = criteria()
+        self.assertEqual(c['chainsaw'], 'Melee only, range 1.5m. Can hit visible enemies from here: no.')
+        self.assertNotIn('Ammo', c['melee'])
+
+    def test_shots_left_text_is_an_explicit_a_b_option(self):
+        with mock.patch.object(policy, 'WEAPON_TEXT_SHOTS', True):
+            c = criteria()
+        self.assertTrue(c['shotgun'].endswith('Shots left: 50.'))
+        self.assertTrue(c['chainsaw'].endswith('No ammunition needed.'))
+
+    def test_melee_options_are_listed_last(self):
+        self.assertEqual([k for k in criteria() if k != 'keep'][-2:], ['melee', 'chainsaw'])
