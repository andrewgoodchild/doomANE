diff --git a/assets/carry_inventory.acs b/assets/carry_inventory.acs
new file mode 100644
index 0000000..41528a3
--- /dev/null
+++ b/assets/carry_inventory.acs
@@ -0,0 +1,106 @@
+#library "LAYACARRY"
+#include "zcommon.acs"
+
+// Carries the player's inventory to the next map, as a vanilla campaign does: weapons, ammo,
+// backpack, health and armour; keys and powerups are not carried. ViZDoom starts a new game for
+// every map, so the harness keeps the values in server CVARs (CVARINFO) and sets
+// laya_carry_pending to a serial number; the ENTER script restores them and reports the serial.
+
+// Published every tic for the harness (ViZDoom reads them as USER20..USER31).
+global int 20:carryReady;      // 2741 while the observer runs
+global int 21:carryHealth;
+global int 22:carryArmor;
+global int 23:carryArmorType;  // 0 none, 1 saves 33 % (green armour or bonuses), 2 saves 50 % (blue)
+global int 24:carryBackpack;
+global int 25:carryClip;
+global int 26:carryShell;
+global int 27:carryRocket;
+global int 28:carryCell;
+global int 29:carryWeapons;    // bit i = weapon i, numbered as in weapon_sensor.acs
+global int 30:carrySelected;
+global int 31:carryRestored;   // serial of the last restore
+
+str weaponNames[10] = {"", "Fist", "Pistol", "Shotgun", "Chaingun", "RocketLauncher",
+                       "PlasmaRifle", "BFG9000", "SuperShotgun", "Chainsaw"};
+
+function void SetAmmo(str type, int amount)
+{
+    TakeInventory(type, CheckInventory(type));
+    if (amount > 0)
+        GiveInventory(type, amount);
+    // Skills 1 and 5 double ammo given, so remove the excess.
+    int extra = CheckInventory(type) - amount;
+    if (extra > 0)
+        TakeInventory(type, extra);
+}
+
+script "LayaCarryRestore" ENTER
+{
+    int serial = GetCVar("laya_carry_pending");
+    if (serial <= 0)
+        terminate;
+    if (GetCVar("laya_carry_backpack"))
+        GiveInventory("Backpack", 1);
+    int owned = GetCVar("laya_carry_weapons");
+    for (int i = 1; i < 10; i++)
+        if (owned & (1 << i))
+            GiveInventory(weaponNames[i], 1);
+    SetAmmo("Clip", GetCVar("laya_carry_clip"));
+    SetAmmo("Shell", GetCVar("laya_carry_shell"));
+    SetAmmo("RocketAmmo", GetCVar("laya_carry_rocket"));
+    SetAmmo("Cell", GetCVar("laya_carry_cell"));
+    int armor = GetCVar("laya_carry_armor");
+    if (armor > 0)
+    {
+        if (GetCVar("laya_carry_armortype") == 2)
+        {
+            GiveInventory("BlueArmor", 1);
+            TakeInventory("BasicArmor", CheckInventory("BasicArmor") - armor);
+        }
+        else
+        {
+            GiveInventory("GreenArmor", 1);
+            if (armor < 100)
+                TakeInventory("BasicArmor", 100 - armor);
+            for (int b = 100; b < armor; b++)
+                GiveInventory("ArmorBonus", 1);
+        }
+    }
+    int selected = GetCVar("laya_carry_selected");
+    if (selected > 0 && selected < 10)
+        SetWeapon(weaponNames[selected]);
