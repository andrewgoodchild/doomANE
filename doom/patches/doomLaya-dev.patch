index 0000000..26a2838
--- /dev/null
+++ b/tests/test_combat_facts.py
@@ -0,0 +1,51 @@
+import unittest
+from types import SimpleNamespace as NS
+from doomlib import combat_facts
+from doomlib.combat_movement import combat_movement_input, semantic_state, combat_features, PREFIX
+from doomlib.typed_movement import PREFIX as TYPED_PREFIX
+
+
+def label(name, category, oid, x, y):
+    return NS(object_name=name, object_category=category, object_id=oid, object_position_x=x, object_position_y=y)
+
+
+class CombatFactsTest(unittest.TestCase):
+    def test_projectile_heading_for_the_player_is_incoming(self):
+        # Player at the origin facing east (angle 0); a fireball 320 units ahead, 20 units to the left, flying west.
+        labels = [label('DoomImpBall', 'Explosive', 5, 320, 20), label('Demon', 'Monster', 6, 96, 0),
+                  label('ShotgunGuy', 'Monster', 7, 600, 0), label('ExplosiveBarrel', 'Explosive', 8, 64, 64)]
+        objects = {5: NS(velocity_x=-10, velocity_y=0), 8: NS(velocity_x=0, velocity_y=0)}
+        facts = combat_facts.compute(labels, objects, 0, 0, 0, 45)
+        self.assertEqual(facts['incoming'], 1)
+        self.assertAlmostEqual(facts['seconds'], 32 / 35, places=2)
+        self.assertEqual(facts['side'], 'left')
+        self.assertEqual((facts['hp'], facts['melee'], facts['hitscan']), (45, 3.0, 1))
+
+    def test_projectile_flying_away_or_wide_is_not_incoming(self):
+        labels = [label('DoomImpBall', 'Explosive', 5, 320, 0), label('DoomImpBall', 'Explosive', 6, 320, 300)]
+        objects = {5: NS(velocity_x=10, velocity_y=0), 6: NS(velocity_x=-10, velocity_y=0)}
+        self.assertEqual(combat_facts.compute(labels, objects, 0, 0, 0, 100)['incoming'], 0)
+
+    def test_round_trip_and_projection(self):
+        facts = dict(incoming=1, seconds=0.4, miss=0.3, side='right', hp=60, melee=99.0, hitscan=2)
+        self.assertEqual(combat_facts.parse('x ' + combat_facts.describe(facts)), facts)
+        criteria = {m: 'Move. Body clearance in this direction: 3.0m.' for m in ('strafe_left', 'strafe_right', 'backward')}
+        criteria['stationary'] = 'Stand still.'
+        question = dict(type='choice', instructions='Choose movement. ' + combat_facts.describe(facts), criteria=criteria)
+        state = 'Movement: stationary.\nEnemies: DoomImp#3 6.0m (visible)'
+        projected, result = combat_movement_input(state, question)
+        self.assertNotIn('Combat facts', result['instructions'])
+        self.assertTrue(any(line.startswith(PREFIX) for line in projected.splitlines()))
+        self.assertFalse(any(line.startswith((PREFIX, TYPED_PREFIX)) for line in semantic_state(projected).splitlines()))
+        self.assertEqual(combat_features(projected), [1 / 3, 0.4, 0.15, 0.0, 1.0, 0.6, 1.0, 0.4])  # melee capped at 32 m
+
+    def test_missing_facts_are_an_error(self):
+        criteria = {m: 'Move. Body clearance in this direction: 3.0m.' for m in ('strafe_left', 'strafe_right', 'backward')}
+        criteria['stationary'] = 'Stand still.'
+        with self.assertRaises(ValueError):
+            combat_movement_input('Movement: stationary.\nEnemies: DoomImp#3 6.0m (visible)',
+                                  dict(type='choice', instructions='Choose movement.', criteria=criteria))
+
+
+if __name__ == '__main__':
+    unittest.main()
