index 0000000..2058d34
--- /dev/null
+++ b/doomlib/carry.py
@@ -0,0 +1,37 @@
+"""Carry the inventory to the next map, as a vanilla campaign does (assets/carry_inventory.acs).
+
+ViZDoom ends the episode at the exit and new_episode() starts a new game with a pistol start.
+With --carry-inventory the harness keeps what the ACS observer last published while the player
+was alive, hands it to the next map through server CVARs, and checks the restore exactly.
+Keys and powerups are not carried, as in vanilla. A death still restarts the map from a pistol start.
+"""
+import vizdoom as vzd
+
+FIELDS = ('health', 'armor', 'armortype', 'backpack', 'clip', 'shell', 'rocket', 'cell', 'weapons', 'selected')
+READY = 2741
+
+
+def _user(game, n):
+    return int(game.get_game_variable(getattr(vzd.GameVariable, f'USER{n}')))
+
+
+def read(game):
+    if _user(game, 20) != READY:
+        raise RuntimeError('Inventory observer is not running')
+    return {name: _user(game, 21 + i) for i, name in enumerate(FIELDS)}
+
+
+def hand_over(game, inventory, serial):
+    """Before new_episode(): the next map's ENTER script restores this inventory."""
+    for name in FIELDS:
+        game.send_game_command(f'set laya_carry_{name} {int(inventory[name])}')
+    game.send_game_command(f'set laya_carry_pending {int(serial)}')
+
+
+def check(game, inventory, serial):
+    """After the first tics of the next map: the fields that differ, as {name: (wanted, got)}."""
+    game.send_game_command('set laya_carry_pending 0')
+    if _user(game, 31) != serial:
+        return {'restored_serial': (serial, _user(game, 31))}
+    got = read(game)
+    return {name: (inventory[name], got[name]) for name in FIELDS if got[name] != inventory[name]}
