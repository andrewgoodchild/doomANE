--- /dev/null
+++ b/tools/check_carry_inventory.py
@@ -0,0 +1,76 @@
+"""Check the inventory carry-over in the engine, without a model: give an inventory on MAP01, exit with
+changemap, hand it over as agent.py does, and compare on MAP02. A death restart must stay a pistol start.
+
+    .venv/bin/python -m tools.check_carry_inventory
+"""
+import argparse
+import json
+
+import vizdoom as vzd
+
+from agent import BUTTONS, make_game
+from doomlib import carry
+
+CASES = [
+    ('pistol start', 3, []),
+    ('green 33 % armour, shells', 3, ['Shotgun', 'GreenArmor', 'Shell']),
+    ('armour bonuses over 100', 3, ['GreenArmor'] + ['ArmorBonus'] * 7 + ['Stimpack']),
+    ('blue armour, backpack, super shotgun, soulsphere', 3, ['SuperShotgun', 'BlueArmor', 'Backpack', 'Soulsphere', 'ClipBox']),
+    ('everything, ammo doubled on skill 1', 1, ['Chainsaw', 'Chaingun', 'RocketLauncher', 'PlasmaRifle', 'BFG9000', 'Backpack', 'Megasphere', 'CellPack']),
+    ('chaingun selected, armour below 100', 3, ['Chaingun', 'GreenArmor', '!take BasicArmor 40', '@4']),
+    ('everything, ammo doubled on skill 5', 5, ['Shotgun', 'RocketLauncher', 'ShellBox', 'RocketBox', 'GreenArmor']),
+]
+
+
+def idle(game, ticks):
+    game.make_action([0] * game.get_available_buttons_size(), ticks)
+
+
+def run(name, skill, items):
+    args = argparse.Namespace(map='MAP01', skill=skill, seed=1, show=False, sound=False, carry_inventory=True)
+    game = make_game(args, no_monsters=True)
+    try:
+        idle(game, 12)
+        for item in items:
+            if item.startswith('@'):  # press SELECT_WEAPONn for a few tics
+                press = [0] * game.get_available_buttons_size()
+                press[BUTTONS.index(getattr(vzd.Button, 'SELECT_WEAPON' + item[1:]))] = 1
+                game.make_action(press, 4)
+            else:
+                game.send_game_command(item[1:] if item.startswith('!') else 'give ' + item)
+                idle(game, 2)
+        idle(game, 35)  # a weapon switch takes a few tics
+        before = carry.read(game)
+        game.send_game_command('changemap MAP02')
+        for _ in range(200):
+            if game.is_episode_finished():
+                break
+            idle(game, 1)
+        assert game.is_episode_finished(), 'changemap did not finish the episode'
+        carry.hand_over(game, before, 1)
+        game.set_doom_map('MAP02')
+        game.new_episode()
+        idle(game, 12)
+        wrong = carry.check(game, before, 1)
+        # A new game without a pending serial (a death restart) is a pistol start again.
+        game.new_episode()
+        idle(game, 12)
+        restart = carry.read(game)
+        pistol = dict(health=100, armor=0, armortype=0, backpack=0, clip=50, shell=0, rocket=0, cell=0, weapons=6, selected=2)
+        restart_wrong = {k: (pistol[k], restart[k]) for k in pistol if restart[k] != pistol[k]}
+        return dict(case=name, skill=skill, carried=before, mismatch=wrong, restart_mismatch=restart_wrong,
+                    ok=not wrong and not restart_wrong)
+    finally:
+        game.close()
+
+
+def main():
+    results = [run(*case) for case in CASES]
+    for r in results:
+        print(json.dumps(r))
+    print('ALL OK' if all(r['ok'] for r in results) else 'FAILED')
+    raise SystemExit(0 if all(r['ok'] for r in results) else 1)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/training/finetune_combat_movement.py b/training/finetune_combat_movement.py
new file mode 100644
index 0000000..718717d
--- /dev/null
+++ b/training/finetune_combat_movement.py
@@ -0,0 +1,160 @@
+"""Train a movement residual on rollout outcomes (doom/fight_rollouts.py) with a frozen Laya head.
+
+Each row is a movement question from a collection run (agent.py --fight-states --combat-facts) with the
+outcome of every movement replayed from the saved engine state. The residual learns soft targets
+softmax(score / temperature) over the four movements; the frozen Laya text branch keeps its own input.
+Validation is on other runs (maps or seeds), and the epoch is chosen by validation regret: the score of
+the best movement minus the score of the movement the head would choose.
+
+  .venv/bin/python training/finetune_combat_movement.py --base checkpoints/laya-doom-v031/laya-v031-movement-numeric-v1 \
+      --rollouts ../../results/doom_heads/fight-rollouts-v1.jsonl --validation-runs <run-name>... \
+      --cache ../../results/doom_heads/combat-movement-cache.json --output ../../results/doom_heads/laya-combat-movement-v1
+"""
+import argparse
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import time
+os.environ.update(USE_TF='0', USE_TORCH='1', TOKENIZERS_PARALLELISM='false')
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from doomlib.compact_movement import MOVEMENTS
+from doomlib.combat_movement import PROJECTION, combat_movement_input, semantic_state
+from doomlib.numeric_movement import COMBAT_FORMAT, combat_feature_names, features, semantic_logits, make_model
+
+
+def digest(path):
+    with Path(path).open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def load(paths):
+    rows = []
+    for path in paths:
+        for line in Path(path).read_text().splitlines():
+            r = json.loads(line)
+            state, question = combat_movement_input(r['raw_state'], r['raw_question'])
+            rows.append(dict(run=r['run'], tick=r['tick'], state=state, question=question,
+                             scores=[r['scores'][m] for m in MOVEMENTS], chosen=r['chosen']))
+    return rows
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    for name in ('base', 'cache', 'output'):
+        p.add_argument('--' + name, type=Path, required=True)
+    p.add_argument('--rollouts', type=Path, nargs='+', required=True)
+    p.add_argument('--validation-runs', nargs='+', required=True, help='run names held out for validation')
+    p.add_argument('--epochs', type=int, default=200)
+    p.add_argument('--temperature', type=float, default=5.0, help='score units (health points) per logit')
+    p.add_argument('--device', default='mps')
+    a = p.parse_args()
+    if a.output.exists():
+        raise ValueError('Output exists')
+    import torch
+    from safetensors.torch import save_file
+    from laya import Agent
+    from doomlib.laya_runtime import enable_single_option_padding
+    torch.manual_seed(771)
+    torch.set_num_threads(2)
+    rows = load(a.rollouts)
+    held = set(a.validation_runs)
+    splits = {'train': [r for r in rows if r['run'] not in held], 'validation': [r for r in rows if r['run'] in held]}
+    if not splits['train'] or not splits['validation']:
+        raise ValueError('Both splits need rows')
+    identity = dict(semantic_weights=digest(a.base / 'model.safetensors'), config=digest(a.base / 'rl_agent_config.json'),
+                    rollouts={str(path): digest(path) for path in a.rollouts}, validation_runs=sorted(held))
+    cache = json.loads(a.cache.read_text()) if a.cache.exists() else dict(identity=identity, answers={})
+    if cache['identity'] != identity:
+        raise ValueError('Semantic cache identity differs')
+    agent = Agent(str(a.base), device=a.device)
+    enable_single_option_padding(agent.model)
+    for split, group in splits.items():
+        if split not in cache['answers']:
+            cache['answers'][split] = [agent.predict(semantic_state(r['state']), {'movement': r['question']})['answers']['movement'] for r in group]
+    a.cache.write_text(json.dumps(cache) + '\n')
+    del agent
+    prepared = {}
+    for split, group in splits.items():
+        scores = torch.tensor([r['scores'] for r in group], dtype=torch.float32)
+        prepared[split] = (torch.tensor([features(r['state'], combat=True) for r in group], dtype=torch.float32),
+                           torch.tensor([semantic_logits(answer) for answer in cache['answers'][split]], dtype=torch.float32),
+                           scores, (scores / a.temperature).softmax(-1),
+                           torch.tensor([MOVEMENTS.index(r['chosen']) for r in group]))
+    names = combat_feature_names()
+    thresholds = {}
+    for index in range(len(names)):
+        unique = prepared['train'][0][:, index].unique().sort().values
+        if len(unique) > 3:
+            thresholds[str(index)] = torch.quantile(unique, torch.linspace(0, 1, min(33, len(unique)))).tolist()
+    spec = dict(format=COMBAT_FORMAT, input_projection=PROJECTION, actions=list(MOVEMENTS), features=list(names),
+                thresholds=thresholds, hidden_size=64, probability_floor=.0001)
+    model = make_model(spec)
+    optimizer = torch.optim.AdamW(model.parameters(), lr=.002, weight_decay=.001)
+
+    def regret(split, choice=None):
+        x, b, scores, _, chosen = prepared[split]
+        if choice is None:
+            model.eval()
+            with torch.no_grad():
+                choice = model(x, b).argmax(-1)
+        picked = scores.gather(1, choice[:, None])[:, 0]
+        return float((scores.max(-1).values - picked).mean())
+
+    x, b, scores, target, chosen = prepared['validation']
+    baselines = dict(semantic=regret('validation', b.argmax(-1)), recorded=regret('validation', chosen),
+                     stationary=regret('validation', torch.zeros(len(x), dtype=torch.long)))
+    print('BASELINE validation regret', baselines, flush=True)
+    best, history = None, []
+    start = time.monotonic()
+    for epoch in range(a.epochs):
+        model.train()
+        x, b, _, target, _ = prepared['train']
+        for indices in torch.randperm(len(x)).split(256):
+            log_p = torch.log_softmax(model(x[indices], b[indices]), -1)
+            loss = -(target[indices] * log_p).sum(-1).mean()
+            optimizer.zero_grad()
+            loss.backward()
+            optimizer.step()
+        value = regret('validation')
+        history.append(dict(epoch=epoch + 1, validation_regret=value, train_regret=regret('train')))
+        if best is None or value < best[0]:
+            best = (value, epoch + 1, copy.deepcopy(model.state_dict()))
+        if epoch % 25 == 0:
+            print('EPOCH', epoch + 1, 'validation regret', round(value, 3), 'best', round(best[0], 3), flush=True)
+    if best[0] >= baselines['semantic']:
+        raise ValueError(f'No improvement on validation regret ({best[0]:.3f} vs semantic {baselines["semantic"]:.3f})')
+
+    def clone(source, target):
+        if sys.platform == 'darwin':
+            subprocess.run(['/bin/cp', '-c', str(source), str(target)], check=True)
+        else:
+            shutil.copyfile(source, target)
+        return target
+    shutil.copytree(a.base, a.output, copy_function=clone)
+    (a.output / 'numeric-residual.json').write_text(json.dumps(spec, indent=2) + '\n')
+    save_file(best[2], str(a.output / 'numeric-residual.safetensors'))
+    config = json.loads((a.output / 'rl_agent_config.json').read_text())
+    config['doom_adaptation']['input_projection'] = PROJECTION
+    config['doom_adaptation']['question_format'] = PROJECTION
+    config['doom_adaptation']['numeric_residual'] = dict(format=COMBAT_FORMAT, spec_sha256=digest(a.output / 'numeric-residual.json'),
+        weights_sha256=digest(a.output / 'numeric-residual.safetensors'), semantic_parent=a.base.name, identity=identity,
+        seed=771, epochs=a.epochs, best_epoch=best[1], temperature=a.temperature, learning_rate=.002,
+        trainer_sha256=digest(__file__), inference_sha256=digest('doomlib/numeric_movement.py'),
+        projection_sha256=digest('doomlib/combat_movement.py'), facts_sha256=digest('doomlib/combat_facts.py'),
+        note='Frozen Laya semantic scores plus a residual trained on replayed outcomes of each movement (health lost, '
+             'damage dealt, death) from saved engine states. Labels come from the game only; validation on other runs.')
+    (a.output / 'rl_agent_config.json').write_text(json.dumps(config, indent=2) + '\n')
+    metrics = dict(baselines=baselines, best_validation_regret=best[0], best_epoch=best[1], seconds=time.monotonic() - start,
+                   rows={k: len(v) for k, v in splits.items()}, epochs=history, identity=identity)
+    (a.output / 'training-metrics.json').write_text(json.dumps(metrics, indent=2) + '\n')
+    (a.output / 'best-epoch.json').write_text(json.dumps(dict(epoch=best[1], validation={'movement_regret': best[0]}, numeric_residual=True), indent=2) + '\n')
+    print('CHECKPOINT', a.output, 'validation regret', round(best[0], 3), 'baselines', baselines, flush=True)
+
+
+if __name__ == '__main__':
+    main()
