+        self.assertNotIn(current.nearest((192,64)),current.reachable((64,64)))
+        nav=Navigator(sectors,doors=[{'sector':0,'key':None,'lowest':-72}])
+        self.assertIn(nav.nearest((192,64)),nav.reachable((64,64)))
+
+    def test_body_against_a_raised_pillar_can_step_out(self):
+        # The cell beside the pillar overlaps it (floor 8) under a 40-unit ceiling, which does not fit; the
+        # player standing there must still be able to leave.
+        sectors=[room(0,128,floor=-96,ceiling=40),room(128,160,floor=8,ceiling=8)]
+        nav=Navigator(sectors,doors=[{'sector':1,'key':None}])
+        self.assertIn(nav.nearest((40,64)),nav.reachable((120,64)))
