diff --git a/tests/test_lift_round_trip.py b/tests/test_lift_round_trip.py
new file mode 100644
index 0000000..bd1b3c6
--- /dev/null
+++ b/tests/test_lift_round_trip.py
@@ -0,0 +1,102 @@
+"""Lift state: a round trip from the upper floor is not a use, one-shot walk lifts stay spent, and the
+boarding point lies on the platform."""
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+import vizdoom
+
+from doomlib.mission import Mission, map_data
+
+
+def lift_case(**extra):
+    lines=[SimpleNamespace(x1=0,y1=0,x2=256,y2=0),SimpleNamespace(x1=256,y1=256,x2=0,y2=256)]
+    sector=SimpleNamespace(lines=lines,floor_height=0,ceiling_height=128)
+    lift=dict(id=7,kind='lift',sectors=[0],upper_floor=0,x=300,y=128,key=None,**extra)
+    return Mission(dict(exits=[],switches=[lift])),sector
+
+
+class LiftRoundTripTest(unittest.TestCase):
+    def test_round_trip_from_the_upper_floor_keeps_the_lift_available(self):
+        mission,sector=lift_case(repeatable=True)
+        mission.observe(dict(x=300,y=128,z=0),[sector])       # on the upper floor, off the platform
+        sector.floor_height=-128
+        mission.observe(dict(x=128,y=128,z=-128),[sector])    # dropped on, lowered
+        sector.floor_height=0
+        top=dict(x=128,y=128,z=0)
+        mission.observe(top,[sector])                          # carried back up without stepping off
+        self.assertFalse(top['switches'][0]['activated'])
+        self.assertEqual(top['switches'][0]['phase'],'call')
+        again=dict(x=128,y=128,z=0)
+        mission.observe(again,[sector])
+        self.assertEqual(again['switches'][0]['phase'],'call')
+
+    def test_ride_up_from_the_lower_floor_is_a_use(self):
+        mission,sector=lift_case(repeatable=True)
+        sector.floor_height=-128
+        mission.observe(dict(x=300,y=128,z=-128),[sector])    # waiting below
+        mission.observe(dict(x=128,y=128,z=-128),[sector])    # boarded below
+        sector.floor_height=0
+        top=dict(x=128,y=128,z=0)
+        mission.observe(top,[sector])
+        self.assertTrue(top['switches'][0]['activated'])
+
+    def test_repeatable_lift_ridden_up_can_be_called_again_from_the_top(self):
+        mission,sector=lift_case(repeatable=True)
+        sector.floor_height=-128
+        mission.observe(dict(x=300,y=128,z=-128),[sector])
+        mission.observe(dict(x=128,y=128,z=-128),[sector])
+        sector.floor_height=0
+        top=dict(x=128,y=128,z=0)
+        mission.observe(top,[sector])
+        self.assertTrue(top['switches'][0]['activated'])
+        off=dict(x=300,y=128,z=0)
+        mission.observe(off,[sector])                          # stepped off at the top
+        self.assertFalse(off['switches'][0]['activated'])
+        self.assertEqual(off['switches'][0]['phase'],'call')
+
+    def test_ride_down_ends_when_the_lift_rests_below(self):
+        mission,sector=lift_case(repeatable=True)
+        mission.observe(dict(x=300,y=128,z=0),[sector])        # on the upper floor, off the platform
+        mission.observe(dict(x=128,y=128,z=0),[sector])        # boarded on the upper floor
+        sector.floor_height=-64
+        moving=dict(x=128,y=128,z=-64)
+        mission.observe(moving,[sector])
+        self.assertEqual(moving['switches'][0]['phase'],'ride')
+        sector.floor_height=-128
+        mission.observe(dict(x=128,y=128,z=-128),[sector])
+        rest=dict(x=128,y=128,z=-128)
+        mission.observe(rest,[sector])                         # at rest below: the trip is over
+        self.assertTrue(rest['switches'][0]['activated'])
+        self.assertEqual(rest['switches'][0]['phase'],'call')
+        off=dict(x=300,y=128,z=-128)
+        mission.observe(off,[sector])
+        self.assertTrue(off['switches'][0]['activated'])
+        sector.floor_height=0                                  # back at the top: it can be called from below
+        later=dict(x=300,y=128,z=-128)
+        mission.observe(later,[sector])
+        self.assertFalse(later['switches'][0]['activated'])
+        self.assertEqual(later['switches'][0]['phase'],'call')
+
+    def test_crossed_one_shot_walk_lift_stays_spent_below(self):
+        mission,sector=lift_case(trigger='walk',a=(100,0),b=(100,256))
+        mission.observe(dict(x=90,y=128,z=0),[sector])
+        mission.observe(dict(x=110,y=128,z=0),[sector])
+        below=dict(x=300,y=128,z=-128)
+        mission.observe(below,[sector])
+        self.assertTrue(below['switches'][0]['activated'])
+
+    def test_board_point_is_on_the_platform(self):
+        data=map_data(Path(vizdoom.__file__).parent/'freedoom2.wad','MAP04',extended=True)
+        lifts={s['id']:s for s in data['switches'] if s['kind']=='lift'}
+        # Switch on a separate wall east of the 256x256 platform (x 0-256, y 1472-1728).
+        x,y=lifts[917]['board']
+        self.assertTrue(0<x<256 and 1472<y<1728,(x,y))
+        # The line is the platform's own edge: the point behind it stays.
+        self.assertEqual(lifts[992]['board'],(128.0,1600.0))
+        # An 8-unit strip cannot hold the player: unchanged.
+        self.assertEqual(lifts[909]['board'],(224.0,1600.0))
+
+
+if __name__=='__main__':
+    unittest.main()
