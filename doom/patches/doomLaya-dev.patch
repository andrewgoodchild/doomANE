@@ -0,0 +1,71 @@
+"""A closing crusher: routes wait outside, a body caught under one steps out; command and target unchanged."""
+import unittest
+from types import SimpleNamespace
+from doomlib.executor import Executor
+from doomlib.mission import Mission
+from tests.test_dynamic_geometry import room
+
+
+def setup(gaps, decision=True, safety=True):
+    sectors=[room(0,128),room(128,256,ceiling=88)]
+    mission=Mission(dict(name='TEST',exits=[],switches=[],crushers=[1],doors=[],teleports=[],key_markers=[]))
+    c=Executor(sectors,mission,crusher_safety=safety)
+    s=dict(x=200.,y=64.,z=0.,angle=0.,keys=[],enemies=[],items=[],walls=dict(left=3,right=3,ahead=3),door=None,
+           hp=100,armor=0,weapon=2,ammo=50,inventory={str(k):dict(owned=k==2,ammo=50) for k in range(1,10)},switches=[])
+    for tick,gap in enumerate(gaps):
+        sectors[1].ceiling_height=gap
+        c.observe(s,tick,sectors)
+    if decision:c.accept(dict(action='wait',command='wait',target=None,weapon=None,decision_id=1,expires_tick=99),len(gaps))
+    return c,s,len(gaps)
+
+
+class CrusherSafetyTest(unittest.TestCase):
+    def test_body_under_a_closing_crusher_steps_out_toward_the_safe_side(self):
+        c,s,tick=setup([88,80,72])
+        buttons,refs=c.act(s,tick)
+        self.assertIn('escape_crusher',refs)
+        self.assertEqual(buttons[1],1)  # facing east, the safe room is behind
+        self.assertEqual(buttons[5],0)
+        self.assertEqual(s['execution']['action'],'wait')
+
+    def test_open_crusher_or_no_decision_or_flag_off_leaves_the_body_alone(self):
+        for gaps,decision,safety in (([88,88,88],True,True),([88,80,72],False,True),([88,80,72],True,False)):
+            with self.subTest(gaps=gaps,decision=decision,safety=safety):
+                c,s,tick=setup(gaps,decision,safety)
+                buttons,refs=c.act(s,tick)
+                self.assertNotIn('escape_crusher',refs)
+                self.assertEqual(buttons[:4],[0,0,0,0])
+
+
+    def brake_case(self,x,step,action='wait',movement=None):
+        c,s,tick=setup([96,92,88])
+        enemy=dict(id=5,name='DoomImp',x=s['x'],y=s['y']+300,z=0,distance=9.,bearing=90,aim_bearing=90,visible=True)
+        target=enemy if action=='attack' else None
+        c.accept(dict(action=action,command=action,target=target,weapon=None,movement=movement,decision_id=2,expires_tick=99),tick)
+        s.update(x=x-step,enemies=[enemy] if target else [])
+        c.act(s,tick)
+        s['x']=x
+        return c.act(s,tick+1)
+
+    def test_momentum_toward_a_closing_crusher_is_braked(self):
+        # Sliding east at 8 units a tic, 40 units short of the crusher's body cells.
+        buttons,refs=self.brake_case(56.,8.)
+        self.assertIn('brake_for_crusher',refs)
+        self.assertEqual(buttons[:4],[0,1,0,0])  # facing east: push back west
+
+    def test_model_strafe_into_a_closing_crusher_is_held(self):
+        # Drifting east toward the crusher during the model's strafe: the strafe gives way to braking west,
+        # while the aim at the model's target stays as it would be.
+        buttons,refs=self.brake_case(80.,6.,'attack','strafe_left')
+        self.assertIn('brake_for_crusher',refs)
+        self.assertEqual(buttons[:4],[0,1,0,0])
+        self.assertEqual(buttons[4],self.brake_case(24.,0.,'attack','strafe_left')[0][4])
+
+    def test_still_body_far_from_the_crusher_keeps_its_movement(self):
+        buttons,refs=self.brake_case(24.,0.,'attack','strafe_left')
+        self.assertNotIn('brake_for_crusher',refs)
+        self.assertEqual(buttons[2],1)
+
+
+if __name__=='__main__':
+    unittest.main()
