@@ -0,0 +1,79 @@
+import unittest
+from pathlib import Path
+import vizdoom
+from doomlib import specials
+from doomlib.mission import map_data, Mission, LEGACY_SWITCHES
+
+WAD = Path(vizdoom.__file__).parent / 'freedoom2.wad'
+
+
+class SpecialsTableTest(unittest.TestCase):
+    def test_vanilla_numbers(self):
+        self.assertEqual(specials.describe(88), specials.Special('walk', True, 'lift', None, None))
+        self.assertEqual(specials.describe(109).mover, 'door_open')
+        self.assertEqual(specials.describe(99).key, 'blue')
+        self.assertEqual(specials.describe(38).rule, 'lowest_floor')
+        self.assertIsNone(specials.describe(0))
+        self.assertIsNone(specials.describe(0x3000))  # Boom generalized: not decoded
+
+    def test_destinations_follow_engine_rules(self):
+        # (floor, ceiling) per sector; sector 0 neighbours 1 and 2.
+        sectors = [(64, 128), (0, 200), (32, 96)]
+        around = {1, 2}
+        move = lambda n: specials.destination(specials.describe(n), 0, sectors, around)
+        self.assertEqual(move(38), ('floor', 0))       # lowest neighbouring floor
+        self.assertEqual(move(19), ('floor', 32))      # highest neighbouring floor
+        self.assertEqual(move(36), ('floor', 40))      # turbo: highest neighbour + 8
+        self.assertEqual(move(5), ('floor', 96))       # lowest neighbouring ceiling
+        self.assertEqual(move(56), ('floor', 88))      # ... minus 8 (crushing)
+        self.assertEqual(move(119), ('floor', 64))     # no higher neighbour floor: stays
+        self.assertEqual(move(58), ('floor', 88))      # +24
+        self.assertEqual(move(2), ('ceiling', 92))     # doors stop 4 below the lowest neighbour ceiling
+        self.assertEqual(move(88), ('floor', 0))       # lifts lower to the lowest floor around
+
+
+class MapMechanismsTest(unittest.TestCase):
+    def test_legacy_switch_set_is_unchanged_by_default(self):
+        for name in ('MAP01', 'MAP02', 'MAP03', 'MAP04'):
+            switches = map_data(WAD, name)['switches']
+            self.assertTrue(all(s['special'] in LEGACY_SWITCHES and s['legacy'] for s in switches))
+        self.assertEqual([(s['id'], s['kind']) for s in map_data(WAD, 'MAP01')['switches']], [(839, 'door')])
+
+    def test_extended_mechanisms_include_walk_over_lines(self):
+        switches = map_data(WAD, 'MAP02', extended=True)['switches']
+        lifts = [s for s in switches if s['trigger'] == 'walk']
+        self.assertEqual(sorted(s['special'] for s in lifts), [88, 88, 88])
+        self.assertTrue(all(s['kind'] == 'lift' and not s['legacy'] and s['repeatable'] for s in lifts))
+
+    def test_walk_over_line_counts_as_used_after_a_crossing(self):
+        line = dict(id=7, kind='door', trigger='walk', a=(0, 0), b=(0, 128), x=0, y=64, sectors=[], key=None,
+                    approach=(40, 64), board=(-32, 64))
+        mission = Mission(dict(exits=[], switches=[line]))
+        for x in (20, 5, -5):
+            mission._crossing(line, dict(x=x, y=64))
+        self.assertIn(7, mission.used_switches)
+        far = Mission(dict(exits=[], switches=[line]))
+        for x in (20, -20):
+            far._crossing(line, dict(x=x, y=400))  # beside the segment, not across it
+        self.assertNotIn(7, far.used_switches)
+
+
+if __name__ == '__main__':
+    unittest.main()
+
+
+class StairsTest(unittest.TestCase):
+    def test_builder_raises_the_chain_through_front_sides_with_the_same_flat(self):
+        # Sectors 0 (tagged), 1, 2 share flat FLAT1; 3 has another flat. Lines: 0->1, 1->2, 2->3 (front->back).
+        sectors = [(0, 128, b'FLAT1', b'C', 160, 0, 5), (0, 128, b'FLAT1', b'C', 160, 0, 0),
+                   (0, 128, b'FLAT1', b'C', 160, 0, 0), (0, 128, b'FLAT2', b'C', 160, 0, 0)]
+        sides = [(0, 0, b'-', b'-', b'-', s) for s in (0, 1, 1, 2, 2, 3)]
+        lines = [(0, 1, 4, 0, 0, 0, 1), (1, 2, 4, 0, 0, 2, 3), (2, 3, 4, 0, 0, 4, 5)]
+        self.assertEqual(specials.stairs(specials.describe(7), [0], sectors, lines, sides), {0: 8, 1: 16, 2: 24})
+        self.assertEqual(specials.stairs(specials.describe(127), [0], sectors, lines, sides), {0: 16, 1: 32, 2: 48})
+
+    def test_chain_follows_front_sides_only(self):
+        sectors = [(0, 128, b'F', b'C', 160, 0, 5), (0, 128, b'F', b'C', 160, 0, 0)]
+        sides = [(0, 0, b'-', b'-', b'-', s) for s in (1, 0)]
+        lines = [(0, 1, 4, 0, 0, 0, 1)]  # front side is sector 1, so the step from 0 does not continue
+        self.assertEqual(specials.stairs(specials.describe(8), [0], sectors, lines, sides), {0: 8})
