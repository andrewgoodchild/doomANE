+"""Vanilla Doom 2 linedef specials as data: trigger, repeat, mover and where the mover stops.
+
+One table for every map (from Doom's p_spec.c, p_doors.c, p_floor.c, p_plats.c), so route knowledge on an
+unseen map comes from the same engine rules, never from facts written for a particular map. Boom
+generalized specials are not decoded yet; `describe` reports them as unknown.
+"""
+from collections import namedtuple
+
+Special = namedtuple('Special', 'trigger repeat mover rule key')
+# trigger: manual (door acts on the line's back sector), use, walk, gun, monster (monsters only)
+# mover: door_open, door_raise (opens, waits, closes), door_close, floor_lower, floor_raise, lift, stairs,
+#        ceiling, crusher, teleport, exit, secret_exit, other
+
+
+def _table():
+    t = {}
+
+    def add(numbers, trigger, repeat, mover, rule=None, key=None):
+        for n in numbers:
+            t[n] = Special(trigger, repeat, mover, rule, key)
+
