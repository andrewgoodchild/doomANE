@@ -0,0 +1,44 @@
+"""Movement input with observed combat facts (doomlib/combat_facts.py) for an outcome-trained residual.
+
+Extends the enemy-type projection with one line of combat facts taken from the movement question's
+instructions. The frozen Laya text branch still reads the original v1 compact text (semantic_state);
+only the numeric residual sees the new facts.
+"""
+import math
+import re
+from doomlib.combat_facts import parse
+from doomlib.typed_movement import typed_movement_input, PREFIX as TYPED_PREFIX
+
+PROJECTION = 'movement-compact-v3-combat'
+PREFIX = 'Observed combat: '
+FEATURES = ('incoming', 'incoming_seconds', 'incoming_miss', 'incoming_left', 'incoming_right',
+            'health', 'melee_nearest', 'hitscan_visible')
+
+
+def combat_movement_input(state, question):
+    facts = parse(question.get('instructions', ''))
+    if facts is None:
+        raise ValueError('Missing combat facts in the movement question')
+    projected, result = typed_movement_input(state, question)
+    line = (f"{PREFIX}incoming {facts['incoming']}; soonest {facts['seconds'] if facts['seconds'] is not None else 'none'} s; "
+            f"miss {facts['miss'] if facts['miss'] is not None else 'none'} m; side {facts['side']}; health {facts['hp']}; "
+            f"nearest melee {facts['melee']:.1f} m; visible hitscan {facts['hitscan']}.")
+    return projected + '\n' + line, result
+
+
+def semantic_state(state):
+    """The frozen text branch keeps its original v1 input."""
+    return '\n'.join(line for line in state.splitlines() if not line.startswith((PREFIX, TYPED_PREFIX)))
+
+
+def combat_features(state):
+    found = re.search(re.escape(PREFIX) + r'incoming (\d+); soonest ([0-9.]+|none) s; miss ([0-9.]+|none) m; side (left|right|none); '
+                      r'health (-?\d+); nearest melee ([0-9.]+) m; visible hitscan (\d+)\.', state)
+    if not found:
+        raise ValueError('Missing observed combat facts')
+    incoming, seconds, miss, side, hp, melee, hitscan = found.groups()
+    values = [min(int(incoming), 5) / 3, 1.0 if seconds == 'none' else float(seconds), 2.0 if miss == 'none' else min(float(miss), 2) / 2,
+              float(side == 'left'), float(side == 'right'), max(0, int(hp)) / 100, min(float(melee), 32) / 32, min(int(hitscan), 10) / 5]
+    if not all(math.isfinite(v) for v in values):
+        raise ValueError('Invalid observed combat facts')
+    return values
