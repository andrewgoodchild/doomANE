@@ -0,0 +1,37 @@
+"""--run-navigation: a route is followed running; without the flag, and for a model's wait, the body walks."""
+import unittest
+from doomlib.executor import Executor
+from doomlib.mission import Mission
+from tests.test_dynamic_geometry import room
+
+
+def act(action, run_navigation):
+    sectors=[room(0,128),room(128,256)]
+    mission=Mission(dict(name='TEST',exits=[],switches=[],crushers=[],doors=[],teleports=[],key_markers=[]))
+    c=Executor(sectors,mission,run_navigation=run_navigation)
+    s=dict(x=40.,y=64.,z=0.,angle=0.,keys=[],enemies=[],items=[],walls=dict(left=3,right=3,ahead=3),door=None,
+           hp=100,armor=0,weapon=2,ammo=50,inventory={str(k):dict(owned=k==2,ammo=50) for k in range(1,10)},switches=[])
+    item=dict(id=7,name='Medikit',category='Health',x=220.,y=64.,z=0.,distance=5.6,bearing=0)
+    c.observe(s,0,sectors)
+    c.known[7]=item
+    c.accept(dict(action=action,command=action,target=item if action=='pickup' else None,weapon=None,decision_id=1,expires_tick=99),1)
+    buttons,_=c.act(s,1)
+    return c,buttons
+
+
+class RunNavigationTest(unittest.TestCase):
+    def test_route_is_followed_running_only_with_the_flag(self):
+        c,buttons=act('pickup',True)
+        self.assertTrue(any(buttons[:4]))
+        self.assertTrue(c.running)
+        c,buttons=act('pickup',False)
+        self.assertTrue(any(buttons[:4]))
+        self.assertFalse(c.running)
+
+    def test_wait_does_not_run(self):
+        c,_=act('wait',True)
+        self.assertFalse(c.running)
+
+
+if __name__=='__main__':
+    unittest.main()
