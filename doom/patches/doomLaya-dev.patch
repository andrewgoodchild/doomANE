+
+SPECIALS = _table()
+OPENS_ROUTE = ('door_open', 'door_raise', 'floor_lower', 'floor_raise', 'lift', 'stairs')
+
+
+def describe(number):
+    """The special's entry, or None for 0 and for numbers vanilla Doom does not define."""
+    return SPECIALS.get(number)
+
+
+def neighbours(sector, lines, sides):
+    """Sectors sharing a two-sided linedef with this one."""
+    result = set()
+    for line in lines:
+        front, back = line[5], line[6]
+        if back == 65535:
+            continue
+        a, b = sides[front][-1], sides[back][-1]
+        if a == sector and b != sector:
+            result.add(b)
+        elif b == sector and a != sector:
+            result.add(a)
+    return result
+
+
+def stairs(special, tagged, sectors, lines, sides):
+    """Final floor of every step a stair builder raises, as {sector: height} (p_floor.c EV_BuildStairs).
+
+    From each tagged sector (in sector order) the builder raises that sector by the step size, then moves on
+    through the first two-sided line, in linedef order, whose front side is the current step and whose back
+    sector has the same floor flat; each further step is one step size higher. As in vanilla, a sector that
+    is already moving ends the chain after the height has been counted."""
+    size = 16 if special.rule == 'step16' else 8
+    touching = {}
+    for line in lines:
+        for side in (line[5], line[6]):
+            if side != 65535:
+                touching.setdefault(sides[side][-1], []).append(line)
+    heights = {}
+    for start in sorted(tagged):
+        if start in heights:
+            continue
+        sector, height = start, sectors[start][0] + size
+        heights[sector] = height
+        while True:
+            for line in touching.get(sector, ()):
+                if not line[2] & 4 or line[6] == 65535 or sides[line[5]][-1] != sector:
+                    continue
+                step = sides[line[6]][-1]
+                if sectors[step][2] != sectors[start][2]:
+                    continue
+                height += size
+                if step in heights:
+                    continue
+                sector = step
+                heights[sector] = height
+                break
+            else:
+                break
+    return heights
+
+
+def destination(special, sector, sectors, around):
+    """(part, height) where the mover leaves this sector, from the WAD's initial heights; None if unknown.
+
+    sectors are WAD SECTORS tuples (floor, ceiling, ...); around is the neighbour set from `neighbours`.
+    Lifts report the low end of their travel: the high end is the sector's own floor.
+    """
+    floor, ceiling = sectors[sector][0], sectors[sector][1]
+    floors = [sectors[i][0] for i in around]
+    ceilings = [sectors[i][1] for i in around]
+    mover, rule = special.mover, special.rule
+    if mover in ('door_open', 'door_raise'):
+        return ('ceiling', min(ceilings) - 4) if ceilings else None
+    if mover == 'lift':
+        return ('floor', min([floor] + floors))
+    if mover == 'floor_lower':
+        if rule == 'lowest_floor':
+            return ('floor', min([floor] + floors))
+        if not floors:
+            return None
+        highest = max(floors)
+        if rule == 'highest_floor_plus8' and highest != floor:
+            highest += 8
+        return ('floor', highest)
+    if mover == 'floor_raise':
+        if rule in ('lowest_ceiling', 'lowest_ceiling_minus8'):
+            if not ceilings:
+                return None
+            height = min(min(ceilings), ceiling) - (8 if rule == 'lowest_ceiling_minus8' else 0)
+            return ('floor', height)
+        if rule == 'next_floor':
+            higher = [f for f in floors if f > floor]
+            return ('floor', min(higher)) if higher else ('floor', floor)
+        if rule in ('plus24', 'plus32', 'plus512'):
+            return ('floor', floor + int(rule[4:]))
+    return None
