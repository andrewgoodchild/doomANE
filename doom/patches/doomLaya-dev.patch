+"""Observed combat facts for the movement question: incoming projectiles, health and threat types.
+
+Only what the player can see is used: projectiles and monsters in the labels buffer (on screen), with
+the engine's velocity for a visible projectile (its motion between frames). A projectile is any visible
+moving object of category Explosive, so no list of projectile names is needed. Monster classes are
+Doom's own (melee-only monsters, hitscan shooters), the same on every map.
+
+The facts travel in the movement question's instructions ("Combat facts: ..."), which the compact
+movement projections replace, so heads trained without them see unchanged inputs.
+"""
+import math
+import re
+
+MELEE_MONSTERS = ('Demon', 'Spectre', 'LostSoul')
+HITSCAN_MONSTERS = ('Zombieman', 'ShotgunGuy', 'ChaingunGuy', 'WolfensteinSS', 'SpiderMastermind')
+HORIZON_TICS = 35  # projectiles reaching the player within a second
+HIT_RADIUS = 64  # passing this close counts as incoming (player radius 16 plus most missiles' 6-20, plus margin)
+FAR = 99.0
+
+
+def compute(labels, objects, px, py, angle, hp):
+    """labels: ViZDoom labels (name, category, id, position); objects: id -> object with velocity."""
+    facing = math.radians(angle)
+    left = (-math.sin(facing), math.cos(facing))
+    incoming = []
+    melee, hitscan = FAR, 0
+    for label in labels:
+        category = str(label.object_category)
+        name = label.object_name
+        rx, ry = label.object_position_x - px, label.object_position_y - py
+        if category == 'Monster' and not name.startswith('Dead'):
+            if name in MELEE_MONSTERS:
+                melee = min(melee, math.hypot(rx, ry) / 32)
+            elif name in HITSCAN_MONSTERS:
+                hitscan += 1
+            continue
+        obj = objects.get(label.object_id)
+        if category != 'Explosive' or obj is None:
+            continue
+        vx, vy = obj.velocity_x, obj.velocity_y
+        speed2 = vx * vx + vy * vy
+        if speed2 < 1:
+            continue  # barrels and other resting explosives
+        t = -(rx * vx + ry * vy) / speed2
+        if not 0 < t <= HORIZON_TICS:
+            continue
+        mx, my = rx + vx * t, ry + vy * t
+        miss = math.hypot(mx, my)
+        if miss <= HIT_RADIUS:
+            incoming.append((t, miss, 'left' if mx * left[0] + my * left[1] > 0 else 'right'))
+    soonest = min(incoming, default=None)
+    return dict(incoming=len(incoming), seconds=round(soonest[0] / 35, 2) if soonest else None,
+                miss=round(soonest[1] / 32, 2) if soonest else None, side=soonest[2] if soonest else 'none',
+                hp=round(float(hp)), melee=round(melee, 1), hitscan=hitscan)
+
+
+def describe(facts):
+    return (f"Combat facts: incoming={facts['incoming']}; incoming_seconds={facts['seconds'] if facts['seconds'] is not None else 'none'}; "
+            f"incoming_miss={facts['miss'] if facts['miss'] is not None else 'none'}; incoming_side={facts['side']}; "
+            f"hp={facts['hp']}; melee_nearest={facts['melee']}; hitscan_visible={facts['hitscan']}.")
+
+
+PATTERN = re.compile(r'Combat facts: incoming=(\d+); incoming_seconds=([0-9.]+|none); incoming_miss=([0-9.]+|none); '
+                     r'incoming_side=(left|right|none); hp=(-?\d+); melee_nearest=([0-9.]+); hitscan_visible=(\d+)\.')
+
+
+def parse(text):
+    found = PATTERN.search(text or '')
+    if not found:
+        return None
+    incoming, seconds, miss, side, hp, melee, hitscan = found.groups()
+    return dict(incoming=int(incoming), seconds=None if seconds == 'none' else float(seconds),
+                miss=None if miss == 'none' else float(miss), side=side, hp=int(hp), melee=float(melee), hitscan=int(hitscan))
